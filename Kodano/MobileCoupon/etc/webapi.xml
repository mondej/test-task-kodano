<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- GET /V1/mobile-coupons - List all mobile-only rules -->
    <route url="/V1/mobile-coupons" method="GET">
        <service class="Kodano\MobileCoupon\Api\MobileCouponManagementInterface" method="getList"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>

    <!-- POST /V1/mobile-coupons/:ruleId - Mark rule as mobile-only -->
    <route url="/V1/mobile-coupons/:ruleId" method="POST">
        <service class="Kodano\MobileCoupon\Api\MobileCouponManagementInterface" method="markAsMobile"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>

    <!-- DELETE /V1/mobile-coupons/:ruleId - Remove mobile-only flag -->
    <route url="/V1/mobile-coupons/:ruleId" method="DELETE">
        <service class="Kodano\MobileCoupon\Api\MobileCouponManagementInterface" method="unmarkAsMobile"/>
        <resources>
            <resource ref="Magento_SalesRule::quote"/>
        </resources>
    </route>

</routes>
