{
	"info": {
		"_postman_id": "kodano-mobile-coupon",
		"name": "Kodano_MobileCoupon API",
		"description": "REST API endpoints for Kodano_MobileCoupon module",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://app.kodano.test",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Get Admin Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var token = pm.response.text().replace(/\"/g, '');",
							"pm.collectionVariables.set('admin_token', token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin123!\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/rest/V1/integration/admin/token",
					"host": ["{{base_url}}"],
					"path": ["rest", "V1", "integration", "admin", "token"]
				}
			}
		},
		{
			"name": "2. Get Customer Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var token = pm.response.text().replace(/\"/g, '');",
							"pm.collectionVariables.set('customer_token', token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"customer@example.com\",\n    \"password\": \"Password123!\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/rest/V1/integration/customer/token",
					"host": ["{{base_url}}"],
					"path": ["rest", "V1", "integration", "customer", "token"]
				}
			}
		},
		{
			"name": "Mobile Coupons API",
			"item": [
				{
					"name": "GET - List Mobile-Only Rules",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/rest/V1/mobile-coupons",
							"host": ["{{base_url}}"],
							"path": ["rest", "V1", "mobile-coupons"]
						},
						"description": "Returns list of all Cart Price Rules marked as mobile-only (on_mobile=1)"
					}
				},
				{
					"name": "POST - Mark Rule as Mobile-Only",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/rest/V1/mobile-coupons/1",
							"host": ["{{base_url}}"],
							"path": ["rest", "V1", "mobile-coupons", "1"]
						},
						"description": "Marks Cart Price Rule with given ID as mobile-only. Replace '1' with actual rule_id."
					}
				},
				{
					"name": "DELETE - Remove Mobile-Only Flag",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/rest/V1/mobile-coupons/1",
							"host": ["{{base_url}}"],
							"path": ["rest", "V1", "mobile-coupons", "1"]
						},
						"description": "Removes mobile-only flag from Cart Price Rule. Replace '1' with actual rule_id."
					}
				}
			]
		},
		{
			"name": "Apply Coupon (Test Validation)",
			"item": [
				{
					"name": "Apply Coupon - WITHOUT Mobile Header (Should FAIL for mobile-only)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/rest/V1/carts/mine/coupons/MOBILECODE",
							"host": ["{{base_url}}"],
							"path": ["rest", "V1", "carts", "mine", "coupons", "MOBILECODE"]
						},
						"description": "Attempts to apply coupon WITHOUT X-Mobile-App header. Should fail with error: 'This coupon code is valid only for mobile app purchases.'"
					}
				},
				{
					"name": "Apply Coupon - WITH Mobile Header (Should SUCCEED)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Mobile-App",
								"value": "true"
							}
						],
						"url": {
							"raw": "{{base_url}}/rest/V1/carts/mine/coupons/MOBILECODE",
							"host": ["{{base_url}}"],
							"path": ["rest", "V1", "carts", "mine", "coupons", "MOBILECODE"]
						},
						"description": "Applies coupon WITH X-Mobile-App: true header. Should succeed for mobile-only coupons."
					}
				}
			]
		}
	]
}
